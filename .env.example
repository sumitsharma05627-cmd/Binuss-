# ==============================================================================
# GWALIOR WEB LABS – SOCIAL COMMAND CENTER
# Production Environment Variables Template
# Developer: Gwalior Web Labs (https://gwlweblab.com)
# ==============================================================================

# Core Application & Dev Server
PORT=3000
NODE_ENV=production
APP_URL="https://gwlweblab.com"
JWT_SECRET="replace-with-a-secure-random-64-character-secret"

# Super Admin Credentials
ADMIN_EMAIL="gwaliorweblabs@gmail.com"
ADMIN_PASSWORD="ReplaceWithSuperAdminPassword"

# Gemini AI API Key (Content generation, hashtag suggestions & caption rephrasing)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase PostgreSQL Database & Row Level Security (Optional for cloud DB)
# Run migration: supabase/migrations/20261107_social_command_center_rls.sql
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres"

# Meta Graph API (Instagram Professional & Facebook Pages)
# Developer Portal: https://developers.facebook.com
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_REDIRECT_URI="${APP_URL}/api/social/oauth/meta/callback"

# Google & YouTube Data API v3
# Cloud Console: https://console.cloud.google.com
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="${APP_URL}/api/social/oauth/google/callback"

# LinkedIn Community Management API
# Developer Portal: https://developer.linkedin.com
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_REDIRECT_URI="${APP_URL}/api/social/oauth/linkedin/callback"

# X (Twitter) Developer API v2
# Developer Portal: https://developer.twitter.com
TWITTER_CLIENT_ID="your-twitter-client-id"
TWITTER_CLIENT_SECRET="your-twitter-client-secret"
TWITTER_REDIRECT_URI="${APP_URL}/api/social/oauth/twitter/callback"

# WhatsApp Business Cloud API
# Meta Developer Portal
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-waba-id"
WHATSAPP_SYSTEM_USER_ACCESS_TOKEN="your-permanent-system-user-token"

# Telegram Bot API
# BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Pinterest API v5
PINTEREST_APP_ID="your-pinterest-app-id"
PINTEREST_APP_SECRET="your-pinterest-app-secret"

# Reddit OAuth API
REDDIT_CLIENT_ID="your-reddit-client-id"
REDDIT_CLIENT_SECRET="your-reddit-client-secret"

# Payment Gateways (Razorpay for INR, Stripe for USD/International)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
STRIPE_PUBLISHABLE_KEY="pk_live_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
